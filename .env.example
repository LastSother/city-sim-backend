# Ключ OpenAI (без него NPC отвечают заглушкой, в логах предупреждение)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Строка подключения к БД (по умолчанию локальный SQLite-файл app/city.db)
# SQLITE_URL=sqlite:///./city.db

# Секрет мэра для POST /issue_law (заголовок X-Admin-Token). Без него эндпоинт возвращает 503.
ADMIN_TOKEN=change-me
# Токен для WebSocket (?token=...). Пусто — проверка отключена.
# Внимание: этот токен попадает в бандл фронтенда (VITE_WS_TOKEN) и не является секретом.
WS_TOKEN=
# Разрешённые источники CORS через запятую
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Лимит запросов к ИИ на IP в минуту
AI_RATE_LIMIT_PER_MIN=10
WS_MAX_CONNECTIONS_PER_TOPIC=100
WS_MAX_MESSAGE_CHARS=500
